# Copy to .env for local development:  cp .env.example .env
# Every value here is for LOCAL DEVELOPMENT ONLY, with fictional data.
# Never reuse these values in any shared or production environment; production secrets
# live in the cloud provider's secret manager, never in a file in the repo.

# --- PostgreSQL superuser (used once by the setup step to create roles and the database)
POSTGRES_PASSWORD=dev-postgres-password
LEGALOS_DB_ADMIN_URL=postgresql://postgres:dev-postgres-password@db:5432/postgres

# --- Application database connections
# Restricted app role used by the API and worker (cannot bypass Row-Level Security).
LEGALOS_DATABASE_URL=postgresql+psycopg://legalos_app:dev-app-password@db:5432/legalos
# Table-owner role used only for migrations and provisioning scripts.
LEGALOS_DATABASE_OWNER_URL=postgresql+psycopg://legalos_owner:dev-owner-password@db:5432/legalos
LEGALOS_DATABASE_APP_ROLE=legalos_app

# --- Security
LEGALOS_ENVIRONMENT=development
# Key that encrypts MFA secrets in the database. DEV ONLY. Generate a new one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEGALOS_ENCRYPTION_KEY=4uV_WrANwhQZxR_YjQQn4xbqgJuBNgdEYq61wwLD9AU=
# Browser origins allowed to send state-changing requests (JSON list).
LEGALOS_ALLOWED_ORIGINS=["http://localhost:3000"]
# false only for local http://localhost. Must be true anywhere with HTTPS.
LEGALOS_SESSION_COOKIE_SECURE=false
# Development only (refused in production): accept the app being opened through another
# address, e.g. a cloud preview pane. Relaxes the login cookie and the Origin check.
LEGALOS_PREVIEW_MODE=false

# --- Object storage (SeaweedFS locally; credentials match infra/local/seaweedfs-s3.json)
# "s3" here. run-local.sh uses "local" (files in LEGALOS_STORAGE_LOCAL_DIR; never in production).
LEGALOS_STORAGE_BACKEND=s3
LEGALOS_STORAGE_ENDPOINT_URL=http://storage:8333
# Address the *browser* uses for signed URLs.
LEGALOS_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:8333
LEGALOS_STORAGE_BUCKET=legalos-documents
LEGALOS_STORAGE_ACCESS_KEY=legalos-dev
LEGALOS_STORAGE_SECRET_KEY=legalos-dev-secret
# In production: AES256 or aws:kms
LEGALOS_STORAGE_SSE=

# --- AI (see ADR-0006)
# "auto": Claude if ANTHROPIC_API_KEY is set, otherwise the simulated demo AI
# (in production without a key, AI is disabled). Never commit a real key.
LEGALOS_AI_PROVIDER=auto
LEGALOS_AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

LEGALOS_LOG_LEVEL=INFO
